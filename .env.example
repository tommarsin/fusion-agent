# GreenNode IAM credentials — for LOCAL DEV only.
# On AgentBase Runtime these are injected automatically; DO NOT put GREENNODE_* in .env.deploy
GREENNODE_CLIENT_ID=
GREENNODE_CLIENT_SECRET=
GREENNODE_AGENT_IDENTITY=

# LLM provider (GreenNode MaaS — OpenAI-compatible)
# Use /agentbase-llm to get LLM_API_KEY and browse models.
# LLM_MODEL must be the `path` field from `models get` output (not the display name).
LLM_API_KEY=
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_MODEL=

# Database (VNG Cloud vDB — Postgres)
DB_HOST=
DB_PORT=5432
DB_NAME=fusion_agent
DB_USER=
DB_PASSWORD=

# Notion integration (Item 9.5 — Content Calendar scan)
# Tạo internal integration tại https://www.notion.so/my-integrations → copy "Internal Integration Secret".
# Nhớ Share database (TLBB2_Content_Calendar) với integration đó thì API mới đọc/ghi được.
NOTION_API_KEY=
NOTION_VERSION=2022-06-28
